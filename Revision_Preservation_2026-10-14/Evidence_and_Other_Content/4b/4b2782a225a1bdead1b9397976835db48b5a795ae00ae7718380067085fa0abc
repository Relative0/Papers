\text{formula-valued LM} \longrightarrow \text{Boolean valuation} \longrightarrow \text{CM/coefficient representation} \longrightarrow \text{state or resource} \longrightarrow \text{effect/measurement} \longrightarrow \text{logical or modal outcome}.
