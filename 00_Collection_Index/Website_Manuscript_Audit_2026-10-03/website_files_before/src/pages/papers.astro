---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = (await getCollection('projects'))
  .filter((project) => project.data.paperTitle)
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Manuscript index – B-Theory" description="Current manuscript lines, precise contributions, status, and reading-copy access for the B-Theory research map.">
  <header class="page-intro">
    <p class="eyebrow">Manuscript index</p>
    <h1>Find the work behind the research map.</h1>
    <p>This index describes six current manuscripts and notes. Five PDF reading copies are available below; the Structured Boolean Factorization note is still being integrated. A reading copy is not a journal publication or a claim of external peer review.</p>
  </header>
  <section class="section-block" aria-labelledby="selected-papers-title">
    <div class="section-heading"><p class="eyebrow">Selected research</p><h2 id="selected-papers-title">Current manuscript lines</h2></div>
    <div class="paper-access-note"><strong>About these versions:</strong> <span>“Site reading copy 1” means the first PDF made available here. Each entry also names the manuscript revision from which that copy came. For questions or an unavailable copy, email <a href="mailto:Brian@B-Theory.com?subject=B-Theory%20manuscript%20request">Brian@B-Theory.com</a>.</span></div>
    <div class="paper-list">
      {projects.map((project) => (
        <article class="paper-list-item" id={project.id}>
          <div><span class="status-label">{project.data.status}</span><h3>{project.data.paperTitle}</h3><p><strong>Contribution:</strong> {project.data.paperContribution}</p><p><strong>Where to look:</strong> {project.data.paperLocation}</p><p><strong>Research status:</strong> {project.data.paperStatus}</p><p><strong>Source revision:</strong> {project.data.paperSourceVersion}</p>{project.data.paperPdf && <p><strong>Site release:</strong> Reading copy 1 · <strong>PDF byline:</strong> {project.data.paperByline}</p>}{!project.data.paperPdf && <p><strong>Reading copy:</strong> Pending integration of later results and a named author line.</p>}</div>
          <div class="paper-actions">
            {project.data.paperPdf && <a class="button button-primary" href={project.data.paperPdf}>Read {project.data.title} PDF</a>}
            <a class="text-link" href={`/${project.id}/`}>About {project.data.title} <span aria-hidden="true">→</span></a>
          </div>
        </article>
      ))}
    </div>
  </section>
  <section class="section-block split-section"><div><p class="eyebrow">Research provenance</p><h2>How these pages were prepared</h2></div><div class="article-copy"><p>The research programme and manuscripts are led by Brian Theory (Brian Droncheff). AI tools have assisted with drafting, organization, computation, and review in parts of the work. Each mathematical claim should be read at the scope stated in its manuscript; AI-assisted checks are distinct from external specialist review.</p><p>The reading copies preserve the author name printed in each source PDF. Brian Theory and Brian Droncheff refer to the same person. The version labels distinguish the first copy posted on this site from the earlier internal revisions of each manuscript; they do not imply journal acceptance.</p></div></section>
</BaseLayout>
